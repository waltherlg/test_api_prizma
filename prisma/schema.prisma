generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  profileId Int    @id @default(autoincrement())
  providerName String
  providerEmail String
  bio       String
  userId    Int   @unique
  User      User  @relation(fields: [userId], references: [userId], onDelete: Cascade)
}

model User {
  userId    Int      @id @default(autoincrement())
  login     String
  email     String   @unique
  Profile   Profile?
}

model Time {
  id Int @id @default(autoincrement())

  DateTime DateTime
  DateTimeAuto DateTime @default(now())

    /// Только дата (без времени)
  DateTimedbDate DateTime @db.Date
  DateTimedbDateD      DateTime @db.Date @default(now())

  /// Дата и время без часового пояса (локальное)
  DateTimedbTimestamp3     DateTime @db.Timestamp(3) 
  DateTimedbTimestamp3D     DateTime @db.Timestamp(3) @default(now())

  /// Дата и время с часовым поясом (UTC, рекомендуется)
   DateTimedbTimestamptz3   DateTime @db.Timestamptz(3)
  DateTimedbTimestamptz3D   DateTime @db.Timestamptz(3) @default(now())

}
